<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:startDestination="@id/categoryFragment">

    <fragment
        android:id="@+id/categoryFragment"
        android:name="com.projs.ecommerceshopping.model.CategoryFragment">

        <action
            android:id="@+id/action_categoryFragment_to_subCategoryFragment"
            app:destination="@id/subCategoryFragment"/>
    </fragment>

    <fragment
        android:id="@+id/subCategoryFragment"
        android:name="com.projs.ecommerceshopping.model.SubCategoryFragment">

        <argument
            android:name="id"
            app:argType="string" />

        <argument
            android:name="name"
            app:argType="string" />

        <action
            android:id="@+id/action_subCategoryFragment_to_productFragment"
            app:destination="@id/productFragment"/>
    </fragment>

    <fragment
        android:id="@+id/productFragment"
        android:name="com.projs.ecommerceshopping.model.ProductFragment">

        <argument
            android:name="subCategoryId"
            app:argType="string" />

        <action
            android:id="@+id/action_productFragment_to_cartFragment"
            app:destination="@id/cartFragment"/>
    </fragment>

    <fragment
        android:id="@+id/cartFragment"
        android:name="com.projs.ecommerceshopping.model.CartFragment">

        <action
            android:id="@+id/action_cartFragment_to_checkoutFragment"
            app:destination="@id/checkoutFragment"/>
    </fragment>

    <fragment
        android:id="@+id/checkoutFragment"
        android:name="com.projs.ecommerceshopping.model.CheckoutFragment">

        <action
            android:id="@+id/action_checkoutFragment_to_orderSuccessFragment"
            app:destination="@id/orderSuccessFragment"/>
    </fragment>

    <fragment
        android:id="@+id/ordersFragment"
        android:name="com.projs.ecommerceshopping.model.OrdersFragment" />

    <fragment
        android:id="@+id/orderSuccessFragment"
        android:name="com.projs.ecommerceshopping.model.OrderSuccessFragment" />

</navigation>